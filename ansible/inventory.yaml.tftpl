all:
  children:
    k8s_cluster:
      children:
        control_plane:
          hosts:
%{ for node in nodes ~}
%{ if node.role == "control" ~}
            ${node.name}:
              ansible_host: ${node.ip}
              node_role: ${node.role}
%{ endif ~}
%{ endfor ~}
        worker_node:
          hosts:
%{ for node in nodes ~}
%{ if node.role == "worker" ~}
            ${node.name}:
              ansible_host: ${node.ip}
              node_role: ${node.role}
%{ endif ~}
%{ endfor ~}
  vars:
    ansible_user: ubuntu
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519
    ansible_python_interpreter: /usr/bin/python3
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'